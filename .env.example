# Copiar a ".env" y completar antes de levantar el stack.

# --- Backend / docker-compose ---
# Contraseña para poder guardar cambios desde el panel admin (/#/admin). Cambiarla siempre.
ADMIN_PASSWORD=changeme
# Origen permitido para llamadas a la API. "*" sirve para desarrollo local; en producción
# conviene restringirlo al dominio real del sitio (ej: https://tu-sitio.com).
CORS_ORIGIN=*

# --- Frontend (Vite) ---
# URL de la API para que el catálogo la use. Debe apuntar al servicio "api" del docker-compose.
VITE_API_URL=http://localhost:4000
